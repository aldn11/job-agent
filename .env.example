# Configurações do Hermes / Docker
HERMES_CONTAINER_NAME=hermes
HERMES_PROFILE=vargas

# Política de localização privada (separe vários valores com ponto e vírgula).
# Configure os valores reais somente no .env local do servidor.
ALLOWED_REMOTE_COUNTRIES=
ALLOWED_ONSITE_LOCATIONS=

# Feed RSS e User-Agent
WWR_FEED_URL=https://weworkremotely.com/categories/remote-customer-support-jobs.rss
USER_AGENT_HTTP=job-agent/1.0 (personal open-source project)
