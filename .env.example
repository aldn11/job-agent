# Configurações do Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Configurações de E-mail (IMAP / Gmail)
IMAP_SERVER=imap.gmail.com
EMAIL_USER=seu_email@gmail.com
