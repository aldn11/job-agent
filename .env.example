# Configurações do Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Configurações de E-mail (IMAP / Gmail)
IMAP_SERVER=imap.gmail.com
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
IMAP_TIMEOUT_SECONDS=120
# Vagas antigas deixam de ser consultadas após este período.
SCRAPE_MAX_AGE_DAYS=30

# Configurações do Hermes / Docker
HERMES_CONTAINER_NAME=hermes
HERMES_PROFILE=vargas
# Timeout longo para avaliações em servidores de baixo desempenho (segundos).
HERMES_TIMEOUT_SECONDS=1800

# Política de localização privada (separe vários valores com ponto e vírgula).
# Configure os valores reais somente no .env local do servidor.
ALLOWED_REMOTE_COUNTRIES=
ALLOWED_ONSITE_LOCATIONS=

# Feed RSS e User-Agent
WWR_FEED_URL=https://weworkremotely.com/categories/remote-customer-support-jobs.rss
JOBSPRESSO_FEED_URL=https://jobspresso.co/feed/?post_type=job_listing
# Em branco usa o feed geral do Remotive; para restringir pelo RSS upstream,
# use slugs verificados separados por ponto e vírgula (ex.: customer-service;sales).
REMOTIVE_FEED_CATEGORIES=
# Filtros opcionais locais dos dois coletores RSS; vazios não restringem vagas.
# Valores em cada linha são separados por ; (OR). Opções diferentes são AND.
# Termos pesquisam título, descrição, tipo e categoria; categorias são exatas;
# localização é substring sem distinção entre maiúsculas/minúsculas.
REMOTIVE_INCLUDE_TERMS=
REMOTIVE_EXCLUDE_TERMS=
REMOTIVE_INCLUDE_CATEGORIES=
REMOTIVE_INCLUDE_LOCATIONS=
JOBSPRESSO_INCLUDE_TERMS=
JOBSPRESSO_EXCLUDE_TERMS=
JOBSPRESSO_INCLUDE_CATEGORIES=
JOBSPRESSO_INCLUDE_LOCATIONS=
USER_AGENT_HTTP=job-agent/1.0 (personal open-source project)
